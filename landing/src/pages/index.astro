---
// WS1 Spike B — decoupled marketing landing (Astro) in front of the MkDocs docs.
// Copy follows the promo-video storyline (ADR-001 §6.1) — same content as
// Spike A so the two prototypes compare framework, not copy.
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
const docs = base + "docs/";

const blocks = [
  { n: "01", title: "Site", text: "Proxmox cluster, storage, network and firewall — the ground your cloud stands on." },
  { n: "02", title: "Workloads", text: "Apps and services installed, updated and backed up by the platform — not by hand." },
  { n: "03", title: "People", text: "Identity, single sign-on and access control for households, teams and tenants." },
  { n: "04", title: "Environments", text: "Clean separation for production, family, tenants and experiments — blast doors included." },
];

const pillars = [
  { title: "Trusted", text: "Open source end to end (MPL 2.0). Every component inspectable, every claim checkable. No black boxes between you and your data." },
  { title: "Automated", text: "One CICD mothership installs, updates, monitors and heals the whole platform. Enterprise operations without an ops team." },
  { title: "Private", text: "Self-hosted by design. Your data never has to leave your building — and your AI can run entirely on your own silicon." },
];

const apps = ["Nextcloud", "Home Assistant", "OpenWebUI", "n8n", "LiteLLM", "vLLM",
              "EURO Office", "deCONZ", "Coturn", "Proxmox", "OPNsense", "Caddy"];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TAPPaaS — Who is in control of your digital life?</title>
    <meta
      name="description"
      content="TAPPaaS is an open-source, self-hosted platform for digital sovereignty — trusted, automated and private cloud capabilities on hardware you own."
    />
    <link rel="icon" href={docs + "tappaas-icon.png"} />
  </head>
  <body>
    <div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>

    <header class="site-header">
      <a class="brand" href={base}>
        <img src={docs + "tappaas-icon.png"} alt="" width="28" height="28" />
        <span>TAPPaaS</span>
      </a>
      <nav>
        <a href="#why">Why</a>
        <a href="#blocks">Building blocks</a>
        <a href="#examples">Examples</a>
        <a href={docs}>Docs</a>
      </nav>
      <a class="btn btn-primary btn-small" href={docs + "installation/"}>Install</a>
    </header>

    <!-- ============ Hero ============ -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true">
        <span class="orb orb-1" data-parallax="30"></span>
        <span class="orb orb-2" data-parallax="-45"></span>
        <span class="orb orb-3" data-parallax="60"></span>
        <span class="gridlines"></span>
      </div>
      <p class="kicker enter">Trusted · Automated · Private · Platform as a Service</p>
      <h1 class="enter">
        Who is in control of<br />
        <span class="grad">your digital life?</span>
      </h1>
      <div class="triad enter" role="list">
        <span role="listitem">Your data.</span>
        <span role="listitem">Your costs.</span>
        <span role="listitem">Your access.</span>
      </div>
      <p class="lede enter">
        TAPPaaS is an open-source, self-hosted platform for digital sovereignty.
        Enterprise-class cloud capabilities — identity, updates, backup, security —
        pre-integrated on hardware you own, for small businesses, governments, NGOs,
        communities and capable households.
      </p>
      <p class="actions enter">
        <a class="btn btn-primary" href={docs + "installation/"}>Get started</a>
        <a class="btn btn-ghost" href="#why">Why TAPPaaS</a>
        <a class="btn btn-ghost" href="https://github.com/TAPPaaS/TAPPaaS">Source code</a>
      </p>
    </section>

    <!-- ============ The glass wall ============ -->
    <section class="section" id="why">
      <h2 class="reveal">Sovereignty is architecture,<br />not a contract.</h2>
      <p class="lede reveal">
        Every cloud sits somewhere on a continuum. On the far side of the glass wall your
        digital life runs on someone else’s terms — their datacenter, their prices, their
        access policies. TAPPaaS moves you to <em>your</em> side of the wall: the same
        convenience, but on your architecture. And because it is architecture, it is
        <strong>resilient</strong> — your platform keeps running even when the internet doesn’t.
      </p>
      <div
        class="continuum reveal"
        role="img"
        aria-label="Continuum from public cloud on their terms, across the glass wall, to a TAPPaaS platform on your own hardware"
      >
        <div class="side theirs">
          <span class="side-label">Their terms</span>
          <span class="item">Public SaaS</span>
          <span class="item">Public cloud</span>
        </div>
        <div class="wall" aria-hidden="true"><span>the glass wall</span></div>
        <div class="side yours">
          <span class="side-label">Your terms</span>
          <span class="item hot">TAPPaaS</span>
          <span class="item">Your hardware</span>
        </div>
      </div>
    </section>

    <!-- ============ Four building blocks ============ -->
    <section class="section" id="blocks">
      <h2 class="reveal">A cloud is four building blocks.<br />Now they’re yours.</h2>
      <p class="lede reveal">
        Hyperscalers won by <em>packaging complexity</em>: a site to run on, workloads to run,
        people to serve, and environments to keep them apart. TAPPaaS packages the same four
        blocks — pre-integrated and open source — on your side of the wall.
      </p>
      <div class="cards">
        {blocks.map((b) => (
          <div class="card reveal">
            <span class="card-n">{b.n}</span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ T · A · P ============ -->
    <section class="section">
      <h2 class="reveal">Trusted. Automated. Private.</h2>
      <div class="pillars">
        {pillars.map((p, i) => (
          <div class="pillar reveal">
            <span class="pillar-letter">{p.title[0]}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ Running today ============ -->
    <section class="section section-wide" id="examples">
      <h2 class="reveal">Running today. Not a roadmap.</h2>
      <p class="lede reveal">TAPPaaS systems are live with first adopters, running the tools people actually use:</p>
      <div class="marquee reveal" aria-hidden="true">
        <div class="track">
          {[...apps, ...apps].map((a) => <span class="chip">{a}</span>)}
        </div>
      </div>
      <div class="marquee marquee-reverse reveal" aria-hidden="true">
        <div class="track">
          {[...apps.slice().reverse(), ...apps.slice().reverse()].map((a) => <span class="chip">{a}</span>)}
        </div>
      </div>
      <p class="center reveal">
        <a class="btn btn-ghost" href={docs + "installation/"}>See what you can run</a>
      </p>
    </section>

    <!-- ============ Closing CTA ============ -->
    <section class="cta">
      <h2 class="reveal">Who is in control? <span class="grad">You are.</span></h2>
      <p class="signoff reveal">Your data. Your costs. Your access. <strong>Your platform.</strong></p>
      <p class="reveal"><a class="btn btn-primary btn-big" href={docs + "installation/"}>Install TAPPaaS</a></p>
    </section>

    <footer class="site-footer">
      <span>© 2026 TAPPaaS Contributors · MPL 2.0</span>
      <nav>
        <a href={docs}>Documentation</a>
        <a href={docs + "roadmap/"}>Roadmap</a>
        <a href="https://github.com/TAPPaaS/TAPPaaS">GitHub</a>
      </nav>
    </footer>

    <script>
      // Scroll progress bar
      const bar = document.getElementById("progress-bar");
      const onScroll = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + "%";
      };
      document.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Reveal on scroll
      const items = document.querySelectorAll(".reveal");
      if (reduced || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.15, rootMargin: "0px 0px -8% 0px" }
        );
        items.forEach((el) => io.observe(el));
      }

      // Gentle pointer parallax on the hero orbs
      if (!reduced) {
        const orbs = document.querySelectorAll("[data-parallax]");
        document.addEventListener(
          "pointermove",
          (ev) => {
            const cx = ev.clientX / window.innerWidth - 0.5;
            const cy = ev.clientY / window.innerHeight - 0.5;
            orbs.forEach((o) => {
              const f = parseFloat(o.dataset.parallax);
              o.style.transform = `translate(${cx * f}px, ${cy * f}px)`;
            });
          },
          { passive: true }
        );
      }

      // Hover glow follows the pointer on cards
      document.querySelectorAll(".card").forEach((card) => {
        card.addEventListener("pointermove", (ev) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty("--mx", ev.clientX - r.left + "px");
          card.style.setProperty("--my", ev.clientY - r.top + "px");
        });
      });
    </script>

    <style>
      /* ---- Shared design tokens (keep in sync with Spike A / future design system) */
      :root {
        --ink: #05090b;
        --panel: #0b161b;
        --teal: #009485;
        --teal-bright: #00d0b0;
        --amber: #ffc46b;
        --text: #dfe9ec;
        --text-dim: #8fa4ab;
        --radius: 16px;
        --font:
          ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
      }

      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--ink);
        color: var(--text);
        font-family: var(--font);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      a { color: inherit; }

      /* ---- Progress bar ---- */
      .progress {
        position: fixed;
        inset: 0 0 auto 0;
        height: 2px;
        z-index: 60;
        background: transparent;
      }
      .progress span {
        display: block;
        height: 100%;
        width: 0;
        background: linear-gradient(90deg, var(--teal), var(--teal-bright));
      }

      /* ---- Header ---- */
      .site-header {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 50;
        display: flex;
        align-items: center;
        gap: 2rem;
        padding: 0.7rem 1.4rem;
        background: rgba(5, 9, 11, 0.55);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(0, 208, 176, 0.12);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-decoration: none;
        font-size: 1.05rem;
      }
      .site-header nav {
        display: flex;
        gap: 1.4rem;
        margin-left: auto;
      }
      .site-header nav a {
        text-decoration: none;
        font-size: 0.88rem;
        color: var(--text-dim);
        transition: color 0.2s ease;
      }
      .site-header nav a:hover { color: var(--teal-bright); }

      /* ---- Buttons ---- */
      .btn {
        display: inline-block;
        padding: 0.65em 1.7em;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.92rem;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
      }
      .btn:hover { transform: translateY(-2px); }
      .btn-primary {
        background: linear-gradient(135deg, var(--teal-bright), var(--teal));
        color: #04231f;
        box-shadow: 0 6px 24px rgba(0, 208, 176, 0.35);
      }
      .btn-primary:hover { box-shadow: 0 10px 32px rgba(0, 208, 176, 0.5); }
      .btn-ghost {
        border: 1px solid rgba(223, 233, 236, 0.35);
        color: var(--text);
      }
      .btn-ghost:hover { border-color: var(--teal-bright); color: var(--teal-bright); }
      .btn-small { padding: 0.45em 1.2em; font-size: 0.82rem; }
      .btn-big { padding: 0.8em 2.4em; font-size: 1.05rem; }

      /* ---- Hero ---- */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 7rem 1.4rem 4rem;
      }
      .hero-bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
      .orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(70px);
        opacity: 0.5;
        transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .orb-1 { width: 42rem; height: 42rem; left: -14rem; top: -12rem;
               background: radial-gradient(circle, rgba(0, 208, 176, 0.55), transparent 65%); }
      .orb-2 { width: 30rem; height: 30rem; right: -10rem; bottom: -8rem;
               background: radial-gradient(circle, rgba(27, 111, 143, 0.6), transparent 65%); }
      .orb-3 { width: 18rem; height: 18rem; right: 16%; top: 10%;
               background: radial-gradient(circle, rgba(255, 196, 107, 0.35), transparent 65%); }
      .gridlines {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(0, 208, 176, 0.05) 1px, transparent 1px),
          linear-gradient(90deg, rgba(0, 208, 176, 0.05) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: radial-gradient(60% 55% at 50% 45%, #000 0%, transparent 100%);
        -webkit-mask-image: radial-gradient(60% 55% at 50% 45%, #000 0%, transparent 100%);
      }

      .kicker {
        position: relative;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        font-size: 0.72rem;
        color: var(--teal-bright);
        margin: 0 0 1rem;
      }
      h1 {
        position: relative;
        font-size: clamp(2.4rem, 7vw, 5rem);
        line-height: 1.04;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0 0 1.4rem;
      }
      .grad {
        background: linear-gradient(100deg, var(--teal-bright) 10%, #7be3d2 45%, var(--amber) 95%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .triad { position: relative; display: flex; gap: 0.7rem; flex-wrap: wrap; justify-content: center; margin-bottom: 1.6rem; }
      .triad span {
        padding: 0.4rem 1.1rem;
        border: 1px solid rgba(0, 208, 176, 0.4);
        border-radius: 999px;
        background: rgba(0, 208, 176, 0.07);
        font-weight: 700;
        font-size: 0.9rem;
        color: #cdf5ee;
      }
      .lede {
        position: relative;
        max-width: 46rem;
        margin: 0 auto 2.2rem;
        color: var(--text-dim);
        font-size: 1.05rem;
      }
      .actions { position: relative; display: flex; gap: 0.8rem; flex-wrap: wrap; justify-content: center; margin: 0; }

      /* entrance animation */
      .enter {
        opacity: 0;
        transform: translateY(22px);
        animation: enter 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
      }
      .enter:nth-of-type(1) { animation-delay: 0.05s; }
      h1.enter { animation-delay: 0.18s; }
      .triad.enter { animation-delay: 0.38s; }
      .lede.enter { animation-delay: 0.52s; }
      .actions.enter { animation-delay: 0.66s; }
      @keyframes enter { to { opacity: 1; transform: none; } }

      /* ---- Sections ---- */
      .section {
        max-width: 62rem;
        margin: 0 auto;
        padding: 6rem 1.4rem;
      }
      .section-wide { max-width: none; padding-left: 0; padding-right: 0; }
      .section-wide > h2, .section-wide > .lede, .section-wide > .center {
        max-width: 62rem; margin-left: auto; margin-right: auto;
        padding-left: 1.4rem; padding-right: 1.4rem;
      }
      h2 {
        font-size: clamp(1.7rem, 4vw, 2.8rem);
        line-height: 1.12;
        font-weight: 800;
        letter-spacing: -0.015em;
        margin: 0 0 1rem;
      }
      .section .lede { margin: 0 0 2.6rem; font-size: 0.98rem; max-width: 46rem; }
      .center { text-align: center; margin-top: 2rem; }

      .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s ease, transform 0.7s ease;
      }
      .reveal.in { opacity: 1; transform: none; }

      /* ---- Continuum ---- */
      .continuum {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid rgba(0, 208, 176, 0.18);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
      }
      .side { display: flex; flex-direction: column; gap: 0.6rem; padding: 2rem 1.8rem; }
      .theirs { background: linear-gradient(135deg, #1c2830, #131d24); color: #9fb2ba; }
      .yours { background: linear-gradient(135deg, #043b36, #0a5f52); text-align: right; color: #d8f5ef; }
      .side-label {
        font-size: 0.64rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        opacity: 0.7;
        margin-bottom: 0.4rem;
      }
      .item { font-weight: 700; font-size: 0.98rem; }
      .item.hot { color: var(--teal-bright); font-size: 1.25rem; }
      .wall {
        position: relative;
        width: 3px;
        background: linear-gradient(180deg, transparent, rgba(0, 208, 176, 0.95), transparent);
        animation: wall 3.5s ease-in-out infinite;
      }
      .wall span {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-90deg);
        white-space: nowrap;
        font-size: 0.62rem;
        letter-spacing: 0.26em;
        text-transform: uppercase;
        color: var(--teal-bright);
        text-shadow: 0 0 14px rgba(0, 208, 176, 0.8);
      }
      @keyframes wall {
        0%, 100% { box-shadow: 0 0 10px rgba(0, 208, 176, 0.4); }
        50% { box-shadow: 0 0 30px rgba(0, 208, 176, 1); }
      }

      /* ---- Cards (building blocks) ---- */
      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        gap: 1.2rem;
      }
      .card {
        position: relative;
        background: var(--panel);
        border: 1px solid rgba(0, 208, 176, 0.16);
        border-radius: var(--radius);
        padding: 1.8rem 1.5rem;
        overflow: hidden;
        transition: transform 0.25s ease, border-color 0.25s ease;
      }
      .card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(24rem 24rem at var(--mx, 50%) var(--my, 50%),
                    rgba(0, 208, 176, 0.14), transparent 60%);
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
      }
      .card:hover { transform: translateY(-6px); border-color: rgba(0, 208, 176, 0.5); }
      .card:hover::before { opacity: 1; }
      .card-n {
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.2em;
        color: var(--teal-bright);
      }
      .card h3 { margin: 0.5rem 0 0.5rem; font-size: 1.15rem; }
      .card p { margin: 0; font-size: 0.85rem; color: var(--text-dim); }
      .cards .reveal:nth-child(2) { transition-delay: 0.1s; }
      .cards .reveal:nth-child(3) { transition-delay: 0.2s; }
      .cards .reveal:nth-child(4) { transition-delay: 0.3s; }

      /* ---- Pillars ---- */
      .pillars {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        gap: 1.2rem;
      }
      .pillar {
        position: relative;
        border-radius: var(--radius);
        padding: 1.8rem 1.5rem 1.6rem;
        background: linear-gradient(170deg, rgba(0, 148, 133, 0.12), rgba(11, 22, 27, 0.9));
        border: 1px solid rgba(0, 208, 176, 0.16);
      }
      .pillar-letter {
        position: absolute;
        right: 0.9rem;
        top: 0.2rem;
        font-size: 4.4rem;
        font-weight: 800;
        color: rgba(0, 208, 176, 0.1);
        line-height: 1;
        user-select: none;
      }
      .pillar h3 { margin: 0 0 0.5rem; font-size: 1.15rem; color: var(--teal-bright); }
      .pillar p { margin: 0; font-size: 0.85rem; color: var(--text-dim); }
      .pillars .reveal:nth-child(2) { transition-delay: 0.12s; }
      .pillars .reveal:nth-child(3) { transition-delay: 0.24s; }

      /* ---- Marquee ---- */
      .marquee {
        overflow: hidden;
        padding: 0.5rem 0;
        mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
      }
      .track {
        display: inline-flex;
        gap: 0.8rem;
        white-space: nowrap;
        animation: marquee 34s linear infinite;
        will-change: transform;
      }
      .marquee-reverse .track { animation-direction: reverse; animation-duration: 42s; }
      .marquee:hover .track { animation-play-state: paused; }
      .chip {
        padding: 0.5rem 1.2rem;
        border: 1px solid rgba(0, 208, 176, 0.25);
        border-radius: 999px;
        background: var(--panel);
        font-size: 0.85rem;
        font-weight: 600;
      }
      @keyframes marquee {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }

      /* ---- CTA & footer ---- */
      .cta {
        text-align: center;
        padding: 8rem 1.4rem;
        background:
          radial-gradient(70rem 35rem at 50% 130%, rgba(0, 208, 176, 0.22), transparent 60%),
          linear-gradient(180deg, var(--ink), #07211f);
      }
      .cta h2 { font-size: clamp(2rem, 5vw, 3.4rem); margin-bottom: 0.8rem; }
      .signoff { color: var(--text-dim); font-size: 1.05rem; margin: 0 0 2.2rem; }
      .signoff strong { color: var(--teal-bright); }

      .site-footer {
        display: flex;
        gap: 1.4rem;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        padding: 1.6rem 1.4rem;
        border-top: 1px solid rgba(0, 208, 176, 0.12);
        font-size: 0.8rem;
        color: var(--text-dim);
      }
      .site-footer nav { display: flex; gap: 1.2rem; }
      .site-footer a { color: var(--text-dim); text-decoration: none; }
      .site-footer a:hover { color: var(--teal-bright); }

      /* ---- Reduced motion & small screens ---- */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation: none !important;
          transition: none !important;
